{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "CachyOS_small",
        "height": 15,
        "width": 30,
        "padding": {
            "top": 2,
            "left": 3
        },
        "color": {
            "1": "#89b4fa",
            "2": "#cba6f7",
            "3": "#94e2d5"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "{#38;2;108;112;134}┌──────────────────────{#38;2;137;180;250}Hardware{#38;2;108;112;134}──────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "disk",
            "key": "└ └󰋊 ",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "custom",
            "format": "{#38;2;108;112;134}└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;108;112;134}┌──────────────────────{#38;2;249;226;175}Software{#38;2;108;112;134}──────────────────────┐"
        },
        {
            "type": "os",
            "key": "󰣇  OS",
            "keyColor": "#f9e2af"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "#f9e2af"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "#f9e2af"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "#f9e2af"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "#f9e2af"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;108;112;134}┌──────────────────────{#38;2;137;180;250}Desktop{#38;2;108;112;134}───────────────────────┐"
        },
        {
            "type": "wm",
            "key": "󱂬  WM",
            "keyColor": "#89b4fa"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "#89b4fa"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "#89b4fa"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "#89b4fa"
        },
        {
            "type": "custom",
            "format": "{#38;2;108;112;134}└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "{#38;2;108;112;134}┌────────────────────{#38;2;203;166;247}Uptime / Age / DT{#38;2;108;112;134}────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "#cba6f7",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "#cba6f7"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "#cba6f7"
        },
        {
            "type": "custom",
            "format": "{#38;2;108;112;134}└────────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
